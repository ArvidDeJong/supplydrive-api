{
    "name": "darvis/supplydrive-api",
    "description": "Laravel client for the Supplydrive Portal API: fetch the delivery status of PEPPOL invoices and other messages sent through Supplydrive, by invoice number, message id or debtor, from PHP, artisan and an MCP server.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://arviddejong.github.io/supplydrive-api/",
    "keywords": [
        "laravel",
        "supplydrive",
        "peppol",
        "e-invoicing",
        "invoice-status",
        "api-client",
        "mcp",
        "laravel-mcp",
        "laravel-boost"
    ],
    "authors": [
        {
            "name": "Arvid de Jong",
            "email": "info@arvid.nl"
        }
    ],
    "support": {
        "issues": "https://github.com/ArvidDeJong/supplydrive-api/issues",
        "source": "https://github.com/ArvidDeJong/supplydrive-api",
        "docs": "https://arviddejong.github.io/supplydrive-api/"
    },
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/encryption": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0",
        "illuminate/translation": "^11.0|^12.0|^13.0",
        "nesbot/carbon": "^2.72|^3.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/mcp": "^1.0",
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0",
        "pestphp/pest-plugin-laravel": "^3.0|^4.0"
    },
    "suggest": {
        "laravel/mcp": "Required for the local MCP server that lets an AI agent look up message statuses (^1.0)."
    },
    "autoload": {
        "psr-4": {
            "Darvis\\SupplydriveApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Darvis\\SupplydriveApi\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest tests",
        "lint": "pint --test",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Darvis\\SupplydriveApi\\SupplydriveApiServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
